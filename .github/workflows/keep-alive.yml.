name: Keep Supabase Alive

on:
  schedule:
    # Todos los días a las 09:00 UTC (~06:00 hora Chile) — bien dentro
    # del límite de 7 días sin actividad que usa Supabase para pausar.
    - cron: '0 9 * * *'
  workflow_dispatch: # permite correrlo manualmente desde la pestaña Actions

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping a Supabase (Auth health check)
        run: |
          curl -f "${{ secrets.SUPABASE_URL }}/auth/v1/health" \
            -H "apikey: ${{ secrets.SUPABASE_ANON_KEY }}"
