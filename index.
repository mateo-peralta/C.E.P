          <input id="input-recordarme" type="checkbox" />
          Recuérdame en este dispositivo
        </label>
        <p id="error-login" class="text-xs text-rojo hidden"></p>
        <p id="msg-login" class="text-xs text-verde hidden"></p>
        <button type="submit" class="mt-1 h-10 rounded-lg bg-marca text-sm font-medium text-white active:scale-[0.98]">Iniciar sesión</button>
        <button type="button" id="btn-olvide-clave" class="text-xs text-marca">¿Olvidaste tu contraseña?</button>
      </form>
      <div class="mt-6 rounded-lg bg-neutral-50 p-3 text-center">
        <p class="text-xs text-neutral-500">Tu sesión se cierra automáticamente al terminar el turno (aplica sin importar "Recuérdame").</p>
      </div>
    </div>
  </main>`;
}

function montarLogin() {
  document.getElementById('form-login').addEventListener('submit', async (e) => {
    e.preventDefault();
    const username = document.getElementById('input-username').value.trim();
    const password = document.getElementById('input-password').value;
    const recordarme = document.getElementById('input-recordarme').checked;
    const errorEl = document.getElementById('error-login');
    errorEl.classList.add('hidden');

    const { data: correo, error: errBusqueda } = await supabase.rpc('obtener_correo_por_username', { p_username: username });
    if (errBusqueda || !correo) {
      errorEl.textContent = 'Usuario no encontrado.';
      errorEl.classList.remove('hidden');
      return;
    }

    // Reconstruimos el cliente con el almacenamiento correcto ANTES de iniciar sesión,
    // para que el token quede guardado en el lugar correcto (localStorage o sessionStorage).
    localStorage.setItem('cep_recordarme', String(recordarme));
    supabase = crearClienteConAlmacenamiento(recordarme);
    supabase.auth.onAuthStateChange(() => render());

    const { error } = await supabase.auth.signInWithPassword({ email: correo, password });
    if (error) {
      errorEl.textContent = 'Usuario o contraseña incorrectos.';
      errorEl.classList.remove('hidden');
      return;
    }
    usuarioActual = null;
    await render();
  });

  document.getElementById('btn-olvide-clave').addEventListener('click', async () => {
    const username = document.getElementById('input-username').value.trim();
    const errorEl = document.getElementById('error-login');
    const msgEl = document.getElementById('msg-login');
    errorEl.classList.add('hidden');
    msgEl.classList.add('hidden');

    if (!username) {
      errorEl.textContent = 'Primero escribe tu nombre de usuario arriba.';
      errorEl.classList.remove('hidden');
      return;
    }

    const { data: correo, error: errBusqueda } = await supabase.rpc('obtener_correo_por_username', { p_username: username });
    if (errBusqueda || !correo) {
      errorEl.textContent = 'Usuario no encontrado.';
      errorEl.classList.remove('hidden');
      return;
    }

    const { error } = await supabase.auth.resetPasswordForEmail(correo, { redirectTo: window.location.href });
    if (error) {
      errorEl.textContent = 'No se pudo enviar el correo: ' + error.message;
      errorEl.classList.remove('hidden');
      return;
    }
    msgEl.textContent = 'Te enviamos un correo con un link para crear una nueva contraseña.';
    msgEl.classList.remove('hidden');
  });
}

