// ---------------- Carga de Excel semanal (reemplaza stock actual) ----------------

const FORMATO_SYROP_EXCEL = FORMATO_SYROP; // mismo mapa que ya usamos en el formulario

function formatoParaTipoSabor(sabor, tipo) {
  if (tipo === 'PULPA' || tipo === 'FRUTA') return 'KILO';
  if (tipo === 'CUBO' || tipo === 'FRAPPE') return 'BOLSA';
  if (tipo === 'BOLSA') return FORMATO_SYROP_EXCEL[sabor.toLowerCase()] || 'BOLSA';
  return 'UNIDAD';
}

/** Busca en el Excel una fila de encabezado con SABORES + al menos un tipo conocido, en cualquier hoja. */
function buscarTablaResumenEnExcel(workbook) {
  const tiposConocidos = ['BOLSA', 'CUBO', 'FRAPPE', 'FRUTA', 'PULPA'];
  for (const nombreHoja of workbook.SheetNames) {
    const hoja = workbook.Sheets[nombreHoja];
    const filas = XLSX.utils.sheet_to_json(hoja, { header: 1, defval: null });
    for (let r = 0; r < filas.length; r++) {
      const fila = (filas[r] || []).map((v) => (typeof v === 'string' ? v.trim().toUpperCase() : v));
      if (fila.includes('SABORES') && tiposConocidos.some((t) => fila.includes(t))) {
        const columnas = {};
        fila.forEach((v, idx) => { if (typeof v === 'string') columnas[v] = idx; });
        return { filas, filaEncabezado: r, columnas };
      }
    }
  }
  return null;
}

async function manejarArchivoExcel(file) {
  const estadoEl = document.getElementById('estado-carga-excel');
  estadoEl.className = 'px-4 pt-2 text-xs text-neutral-500';
  estadoEl.textContent = 'Leyendo archivo...';
  estadoEl.classList.remove('hidden');

  try {
    const buffer = await file.arrayBuffer();
    const workbook = XLSX.read(buffer, { type: 'array' });
    const tabla = buscarTablaResumenEnExcel(workbook);

    if (!tabla) {
      estadoEl.className = 'px-4 pt-2 text-xs text-rojo';
      estadoEl.textContent = 'No encontré una tabla con columna "SABORES" y tipos (BOLSA/CUBO/FRAPPE/FRUTA/PULPA) en este Excel.';
      return;
    }

    const tiposConocidos = ['BOLSA', 'CUBO', 'FRAPPE', 'FRUTA', 'PULPA'];
    const objetivos = []; // { sabor, tipo, cantidadNueva }
    for (let r = tabla.filaEncabezado + 1; r < tabla.filas.length; r++) {
      const fila = tabla.filas[r] || [];
      const sabor = fila[tabla.columnas['SABORES']];
      if (!sabor || typeof sabor !== 'string') continue;
      tiposConocidos.forEach((tipo) => {
        const col = tabla.columnas[tipo];
        if (col === undefined) return;
        const valor = fila[col];
        if (typeof valor === 'number') {
          objetivos.push({ sabor: sabor.trim().toUpperCase(), tipo, cantidadNueva: valor });
        }
      });
    }

    if (objetivos.length === 0) {
      estadoEl.className = 'px-4 pt-2 text-xs text-rojo';
      estadoEl.textContent = 'No encontré cantidades numéricas para cargar en ese archivo.';
      return;
    }

    const { data: stockActual } = await supabase.from('stock_global').select('*');
    const mapaActual = new Map((stockActual || []).map((s) => [`${s.sabor}||${s.tipo}`, s.total]));

    const ajustes = objetivos.map((o) => {
      const actual = mapaActual.get(`${o.sabor}||${o.tipo}`) || 0;
      const delta = o.cantidadNueva - actual;
      return { ...o, actual, delta };
    }).filter((a) => a.delta !== 0);

    if (ajustes.length === 0) {
      estadoEl.className = 'px-4 pt-2 text-xs text-neutral-500';
      estadoEl.textContent = 'El Excel coincide exactamente con el stock actual — no hay nada que ajustar.';
      return;
    }

    const resumenTexto = ajustes.map((a) => `${a.sabor} (${a.tipo}): ${a.actual} → ${a.cantidadNueva} (${a.delta > 0 ? '+' : ''}${a.delta})`).join('\n');
    const confirmar = window.confirm(`Se van a aplicar ${ajustes.length} ajustes para que el stock quede igual al Excel:\n\n${resumenTexto}\n\n¿Confirmas?`);
    if (!confirmar) {
      estadoEl.classList.add('hidden');
      return;
    }

    const semana = semanaActual();
    const filasParaInsertar = ajustes.map((a) => ({
      formato: formatoParaTipoSabor(a.sabor, a.tipo),
      sabor: a.sabor,
      tipo: a.tipo,
      cantidad: a.delta,
      responsable: `${usuarioActual.nombre} (ajuste por Excel)`,
      semana_inicio: semana
    }));

    const { error } = await supabase.from('diario_movimientos').insert(filasParaInsertar);
    if (error) {
      estadoEl.className = 'px-4 pt-2 text-xs text-rojo';
      estadoEl.textContent = error.message;
      return;
    }

    estadoEl.className = 'px-4 pt-2 text-xs text-verde';
    estadoEl.textContent = `✅ Stock actualizado: ${ajustes.length} productos ajustados según el Excel.`;
    document.getElementById('input-excel').value = '';
    setTimeout(() => vistaDiario(), 1200);
  } catch (err) {
    estadoEl.className = 'px-4 pt-2 text-xs text-rojo';
    estadoEl.textContent = 'No pude leer ese archivo: ' + err.message;
  }
}

