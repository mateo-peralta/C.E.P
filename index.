function shell(titulo, contenidoHtml) {
  const esAdmin = usuarioActual.rol === 'admin';
  return `
    <header class="flex items-center gap-2 border-b border-neutral-200 px-4 py-3">
      ${historialPantallas.length > 0 ? `<button id="btn-atras" aria-label="Volver atrás" class="p-1 text-neutral-500">←</button>` : ''}
      <button id="btn-ir-resumen" aria-label="Ir a Resumen">${LOGO_CORTO}</button>
      <p class="flex-1 text-sm font-medium text-marca">${titulo}</p>
      <button id="btn-config" aria-label="Configuración" class="p-1 text-neutral-500"><i class="ti ti-settings"></i>⚙</button>
      <button id="btn-logout" aria-label="Cerrar sesión" class="p-1 text-xs text-neutral-400">Salir</button>
    </header>
    <div id="contenido" class="pb-16">${contenidoHtml}</div>
    <nav class="fixed inset-x-0 bottom-0 flex border-t border-neutral-200 bg-white">
      ${navBoton('diario', 'Diario')}
      ${navBoton('produccion', 'Producción')}
      ${navBoton('resumen', 'Resumen')}
      ${navBoton('global', 'Global')}
    </nav>
  `;
}

function navBoton(clave, etiqueta) {
  const activo = pantalla === clave;
  return `<button data-nav="${clave}" class="flex flex-1 flex-col items-center gap-1 py-2 mx-1 my-1.5 rounded-xl text-[10px] ${activo ? 'bg-marca text-white font-medium' : 'text-neutral-500'}">${etiqueta}</button>`;
}

function montarShell() {
  document.getElementById('btn-atras')?.addEventListener('click', irAtras);
  document.getElementById('btn-ir-resumen')?.addEventListener('click', () => cambiarPantalla('resumen'));
  document.getElementById('btn-logout')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    usuarioActual = null;
    await render();
  });
  document.getElementById('btn-config')?.addEventListener('click', () => cambiarPantalla('configuracion'));
  document.querySelectorAll('[data-nav]').forEach((btn) => {
    btn.addEventListener('click', () => cambiarPantalla(btn.dataset.nav));
  });
}

async function cambiarPantalla(clave) {
  if (pantalla !== clave) historialPantallas.push(pantalla);
  pantalla = clave;
  await renderPantalla();
}

async function irAtras() {
  const anterior = historialPantallas.pop();
  pantalla = anterior || 'resumen';
  await renderPantalla();
}

async function renderPantalla() {
  if (pantalla === 'diario') await vistaDiario();
  else if (pantalla === 'produccion') await vistaProduccion();
  else if (pantalla === 'resumen') await vistaResumen();
  else if (pantalla === 'global') await vistaGlobal();
  else if (pantalla === 'configuracion') await vistaConfiguracion();
}

// ---------------- Diario ----------------

let filtroTipoDiario = '';
let filtroAccionDiario = ''; // '' | 'entrada' | 'salida'
let filtroResponsableDiario = '';

async function vistaDiario() {
  const { data: movimientos } = await supabase
    .from('diario_movimientos').select('*').eq('semana_inicio', semanaActual())
    .order('fecha', { ascending: false }).limit(200);

  const tiposDisponibles = [...new Set((movimientos || []).map((m) => m.tipo))].sort();

  const filtrados = (movimientos || []).filter((m) => {
    if (filtroTipoDiario && m.tipo !== filtroTipoDiario) return false;
    if (filtroAccionDiario === 'entrada' && m.cantidad <= 0) return false;
    if (filtroAccionDiario === 'salida' && m.cantidad >= 0) return false;
    if (filtroResponsableDiario && !m.responsable.toLowerCase().includes(filtroResponsableDiario.toLowerCase())) return false;
    return true;
  });

  const filas = filtrados.map((m) => {
    const positivo = m.cantidad > 0;
    return `
      <div class="flex items-center gap-3 border-b border-neutral-100 px-2 py-2">
        <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full ${positivo ? 'bg-verde/10' : 'bg-rojo/10'}">
          <span style="color:${positivo ? '#1D9E75' : '#E24B4A'}">${positivo ? '↗' : '↘'}</span>
        </span>
        <div class="flex-1">
          <p class="text-sm font-medium">${m.sabor} · ${m.tipo}</p>
          <p class="text-[10.5px] text-neutral-400">${m.responsable} · ${new Date(m.fecha).toLocaleString('es-CL', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })}</p>
        </div>
        <span class="text-sm font-medium" style="color:${positivo ? '#1D9E75' : '#E24B4A'}">${positivo ? '+' : ''}${m.cantidad} ${m.formato}</span>
      </div>`;
  }).join('') || `<p class="px-4 py-6 text-center text-sm text-neutral-400">No hay movimientos con estos filtros.</p>`;

  const permitido = puedeEscribir('diario');

  app.innerHTML = shell('Diario de movimientos', `
    ${permitido ? `<div class="flex justify-end gap-2 px-4 pt-3">
      <button id="btn-cargar-excel" class="rounded-full border border-neutral-200 px-3 py-1.5 text-xs font-medium text-neutral-600">📥 Cargar Excel</button>
      <input id="input-excel" type="file" accept=".xlsx,.xls" class="hidden" />
      <button id="btn-nuevo-diario" class="rounded-full bg-marca px-3 py-1.5 text-xs font-medium text-white">+ Registrar</button>
    </div>
    <p id="estado-carga-excel" class="hidden px-4 pt-2 text-xs"></p>` : ''}

    <div class="flex flex-col gap-2 px-4 pt-3">
      <div class="flex gap-2 overflow-x-auto">
        <button data-accion-filtro="" class="chip-accion whitespace-nowrap rounded-full px-3 py-1.5 text-xs ${filtroAccionDiario === '' ? 'bg-marca text-white' : 'border border-neutral-200 text-neutral-500'}">Todos</button>
        <button data-accion-filtro="entrada" class="chip-accion whitespace-nowrap rounded-full px-3 py-1.5 text-xs ${filtroAccionDiario === 'entrada' ? 'bg-marca text-white' : 'border border-neutral-200 text-neutral-500'}">↗ Entradas</button>
        <button data-accion-filtro="salida" class="chip-accion whitespace-nowrap rounded-full px-3 py-1.5 text-xs ${filtroAccionDiario === 'salida' ? 'bg-marca text-white' : 'border border-neutral-200 text-neutral-500'}">↘ Salidas</button>
      </div>
      <div class="flex gap-2">
        <select id="select-filtro-tipo" class="flex-1">
          <option value="">Todos los tipos</option>
          ${tiposDisponibles.map((t) => `<option value="${t}" ${filtroTipoDiario === t ? 'selected' : ''}>${t}</option>`).join('')}
        </select>
        <input id="input-filtro-responsable" type="text" placeholder="Buscar por encargado" value="${filtroResponsableDiario}" class="flex-1" />
      </div>
    </div>

    <div id="lista-diario" class="px-2 py-2">${filas}</div>
    ${permitido ? formularioDiarioHtml() : ''}
  `);
  montarShell();

  document.querySelectorAll('.chip-accion').forEach((btn) => {
    btn.addEventListener('click', () => { filtroAccionDiario = btn.dataset.accionFiltro; vistaDiario(); });
  });
  document.getElementById('select-filtro-tipo').addEventListener('change', (e) => { filtroTipoDiario = e.target.value; vistaDiario(); });
  document.getElementById('input-filtro-responsable').addEventListener('input', (e) => { filtroResponsableDiario = e.target.value; vistaDiario(); });

  if (permitido) montarFormularioDiario();
}

