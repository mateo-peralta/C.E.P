function obtenerLunesDeLaSemana(fecha) {
  const d = new Date(fecha);
  const dia = d.getDay();
  const diff = d.getDate() - dia + (dia === 0 ? -6 : 1);
  const lunes = new Date(d);
  lunes.setDate(diff);
  return lunes.toISOString().slice(0, 10);
}

async function validarVentanaDeTurno() {
  if (!usuarioActual?.requiere_cierre_turno) return { permitido: true };

  const diasSemana = ['DOMINGO', 'LUNES', 'MARTES', 'MIERCOLES', 'JUEVES', 'VIERNES', 'SABADO'];
  const hoy = new Date();
  const diaHoy = diasSemana[hoy.getDay()];

  if ((usuarioActual.dias_libres || []).includes(diaHoy)) {
    return { permitido: false, razon: `Hoy (${diaHoy.toLowerCase()}) es tu día libre.` };
  }

  const semanaInicio = obtenerLunesDeLaSemana(hoy);
  const { data: fila } = await supabase
    .from('personal_horarios')
    .select('*')
    .eq('nombre_persona', usuarioActual.nombre)
    .eq('semana_inicio', semanaInicio)
    .eq('dia_semana', diaHoy)
    .maybeSingle();

  if (!fila || !fila.hora_salida) {
    return { permitido: false, razon: 'No tienes turno asignado hoy.' };
  }
  return { permitido: true, horaSalida: fila.hora_salida };
}

// ---------------- Utilidades ----------------

function semanaActual() {
  const hoy = new Date();
  const dia = hoy.getDay();
  const diff = hoy.getDate() - dia + (dia === 0 ? -6 : 1);
  return new Date(hoy.setDate(diff)).toISOString().slice(0, 10);
}

function estadoStock(cantidad) {
  if (cantidad < 0) return { clase: 'bg-rojoFluor text-white', valor: cantidad };
  if (cantidad <= 5) return { clase: 'bg-rojo/10 text-rojo', valor: cantidad };
  if (cantidad <= 8) return { clase: 'bg-amarillo/10 text-amarillo', valor: cantidad };
  return { clase: 'bg-verde/10 text-verde', valor: cantidad };
}

const FORMATO_SYROP = {
  'syrop piña': '750 CC', 'syrop manzana': '750 CC',
  'syrop mix berries': '800 CC', 'syrop sandía': '250 CC'
};

function puedeEscribir(area) {
  if (!usuarioActual) return false;
  const permisos = {
    diario: ['admin', 'bodega'],
    produccion: ['admin', 'produccion']
  };
  const permitidos = permisos[area];
  return permitidos ? permitidos.includes(usuarioActual.rol) : true;
}

// ---------------- Render raíz ----------------

async function render() {
  const { data: { session } } = await supabase.auth.getSession();

  if (!session) {
    app.innerHTML = vistaLogin();
    montarLogin();
  } else {
    if (!usuarioActual) {
      const { data } = await supabase.from('usuarios_bot').select('*').eq('auth_user_id', session.user.id).maybeSingle();
      usuarioActual = data;
    }
    if (!usuarioActual) {
      app.innerHTML = `<div class="p-6 text-center text-sm text-neutral-500">Tu cuenta no está vinculada a ningún perfil. Contacta al administrador.</div>`;
    } else {
      const turno = await validarVentanaDeTurno();
      if (!turno.permitido) {
        app.innerHTML = vistaBloqueadaPorTurno(turno.razon);
        montarBloqueoTurno();
      } else {
        await renderPantalla();
      }
    }
  }

  pantallaCarga.classList.add('hidden');
  app.classList.remove('hidden');
}

function vistaBloqueadaPorTurno(razon) {
  return `
  <main class="flex min-h-screen flex-col items-center justify-center gap-4 p-6 text-center">
    ${LOGO_CORTO}
    <p class="text-sm font-medium">Fuera de tu horario de turno</p>
