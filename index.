      </div>

      ${esAdmin ? `
      <div>
        <p class="mb-1 text-sm font-medium">Rangos de alerta de stock</p>
        <p class="mb-3 text-[11px] text-neutral-400">Verde: 9+ · Amarillo: 6-8 · Rojo: 0-5 · Rojo flúor: negativos.</p>
        <p class="text-[11px] text-neutral-400">La edición de estos rangos está disponible en la versión Next.js del proyecto.</p>
