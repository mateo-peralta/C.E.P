let vistaResumenActual = 'tarjetas';
let abiertoResumen = null;

async function vistaResumen() {
  const { data: movimientos } = await supabase.from('diario_movimientos').select('sabor, tipo, cantidad, responsable').eq('semana_inicio', semanaActual());
  const filas = movimientos || [];
  const totalEntradas = filas.filter((f) => f.cantidad > 0).reduce((a, f) => a + f.cantidad, 0);
  const totalSalidas = filas.filter((f) => f.cantidad < 0).reduce((a, f) => a + Math.abs(f.cantidad), 0);

  const mapa = new Map();
  filas.forEach((f) => {
    if (!mapa.has(f.sabor)) mapa.set(f.sabor, { sabor: f.sabor, total: 0, tipos: new Set(), detalle: [] });
    const e = mapa.get(f.sabor);
    e.total += f.cantidad;
    e.tipos.add(f.tipo);
    e.detalle.push({ tipo: f.tipo, cantidad: f.cantidad });
  });
  const porSabor = [...mapa.values()].map((s) => ({ ...s, tipos: [...s.tipos] })).sort((a, b) => a.sabor.localeCompare(b.sabor));
  const tiposUnicos = [...new Set(filas.map((f) => f.tipo))].sort();

  app.innerHTML = shell('Resumen de la semana', `
    <div class="grid grid-cols-2 gap-2 px-4 pt-3">
      <div class="rounded-lg bg-neutral-50 p-2.5"><p class="text-[11px] text-neutral-500">Entradas</p><p class="text-xl font-medium">${totalEntradas}</p></div>
      <div class="rounded-lg bg-neutral-50 p-2.5"><p class="text-[11px] text-neutral-500">Salidas</p><p class="text-xl font-medium">${totalSalidas}</p></div>
    </div>
    <div class="flex justify-between items-center px-4 pt-3">
      <button id="btn-compartir-resumen" class="rounded-full bg-marca px-3 py-1.5 text-xs font-medium text-white">📤 Compartir resumen</button>
      <div class="flex rounded-full bg-neutral-100 p-0.5">
        <button id="btn-vista-tarjetas" class="flex h-7 w-8 items-center justify-center rounded-full text-xs ${vistaResumenActual === 'tarjetas' ? 'bg-marca text-white' : 'text-neutral-500'}">▦</button>
        <button id="btn-vista-tabla" class="flex h-7 w-8 items-center justify-center rounded-full text-xs ${vistaResumenActual === 'tabla' ? 'bg-marca text-white' : 'text-neutral-500'}">▤</button>
      </div>
    </div>
    <p id="msg-compartir" class="hidden px-4 pt-2 text-xs text-verde">Resumen copiado — pégalo en WhatsApp.</p>
    <div id="contenido-resumen"></div>
  `);
  montarShell();
  document.getElementById('btn-vista-tarjetas').addEventListener('click', () => { vistaResumenActual = 'tarjetas'; vistaResumen(); });
  document.getElementById('btn-vista-tabla').addEventListener('click', () => { vistaResumenActual = 'tabla'; vistaResumen(); });
  document.getElementById('btn-compartir-resumen').addEventListener('click', () => compartirResumenTexto(porSabor, totalEntradas, totalSalidas));

  const contenedor = document.getElementById('contenido-resumen');
  if (vistaResumenActual === 'tarjetas') {
    contenedor.innerHTML = porSabor.length ? porSabor.map((s) => {
      const est = estadoStock(s.total);
      const abierto = abiertoResumen === s.sabor;
      return `
        <div>
          <button data-sabor="${s.sabor}" class="btn-toggle-sabor flex w-full items-center gap-3 border-b border-neutral-100 px-2 py-2 text-left">
            <span class="flex-1"><span class="block text-sm font-medium">${s.sabor}</span><span class="block text-[10.5px] text-neutral-400">${s.tipos.join(' · ')}</span></span>
            <span class="rounded-full px-2.5 py-0.5 text-xs font-medium ${est.clase}">${s.total}</span>
          </button>
          ${abierto ? `<div class="px-2 pb-2">${s.detalle.map((d) => `<div class="flex justify-between py-1 text-xs text-neutral-500"><span>${d.tipo}</span><span>${d.cantidad}</span></div>`).join('')}</div>` : ''}
        </div>`;
    }).join('') : `<p class="px-4 py-6 text-center text-sm text-neutral-400">Aún no hay movimientos esta semana.</p>`;

    contenedor.querySelectorAll('.btn-toggle-sabor').forEach((btn) => {
      btn.addEventListener('click', () => {
        abiertoResumen = abiertoResumen === btn.dataset.sabor ? null : btn.dataset.sabor;
        vistaResumen();
      });
    });
  } else {
    const filasTabla = porSabor.map((s) => {
      const est = estadoStock(s.total);
      const celdas = tiposUnicos.map((t) => {
        const encontrado = filas.find((f) => f.sabor === s.sabor && f.tipo === t);
        return `<td class="px-2.5 py-1.5 text-center text-neutral-500">${encontrado ? encontrado.cantidad : '—'}</td>`;
      }).join('');
      return `<tr class="border-b border-neutral-100"><td class="sticky left-0 z-10 bg-white px-2.5 py-1.5 font-medium">${s.sabor}</td>${celdas}<td class="px-2.5 py-1.5 text-center"><span class="rounded-full px-2.5 py-0.5 font-medium ${est.clase}">${s.total}</span></td></tr>`;
    }).join('');
    contenedor.innerHTML = `
      <div class="overflow-x-auto pb-2">
        <table class="border-collapse whitespace-nowrap text-xs">
          <thead><tr>
            <th class="sticky left-0 z-10 bg-white px-2.5 py-2 text-left font-medium text-neutral-500">Sabor</th>
            ${tiposUnicos.map((t) => `<th class="px-2.5 py-2 font-medium text-neutral-500">${t}</th>`).join('')}
            <th class="px-2.5 py-2 font-medium text-neutral-500">Total</th>
          </tr></thead>
          <tbody>${filasTabla}</tbody>
        </table>
      </div>`;
  }
}

/**
 * Arma un texto simple, sin tecnicismos, para compartir por WhatsApp con personas
 * que no usan la plataforma (ej. Victor, Nayareth como jefes que solo quieren ver el resultado).
 */
async function compartirResumenTexto(porSabor, totalEntradas, totalSalidas) {
  const fecha = new Date().toLocaleDateString('es-CL', { day: '2-digit', month: 'long', year: 'numeric' });

  function emojiEstado(total) {
    if (total < 0) return '🟣'; // negativo / rojo flúor
    if (total <= 5) return '🔴';
    if (total <= 8) return '🟡';
    return '🟢';
  }

  let texto = `📋 *Resumen de existencias — ${fecha}*\n\n`;
  texto += `↗ Entradas: ${totalEntradas}   ↘ Salidas: ${totalSalidas}\n\n`;
  porSabor.forEach((s) => {
    texto += `${emojiEstado(s.total)} ${s.sabor}: ${s.total}\n`;
  });
  texto += `\n_Generado por Control de Existencias y Producciones — Mateo Peralta_`;

  const msgEl = document.getElementById('msg-compartir');

  if (navigator.share) {
    try {
      await navigator.share({ title: 'Resumen de existencias', text: texto });
      return;
    } catch (e) {
      // el usuario canceló el share o el navegador lo rechazó; seguimos al respaldo de copiar
    }
  }

  try {
    await navigator.clipboard.writeText(texto);
    msgEl.classList.remove('hidden');
    setTimeout(() => msgEl.classList.add('hidden'), 3000);
  } catch (e) {
    alert(texto); // último respaldo si ni share ni clipboard funcionan
  }
}

// ---------------- Global ----------------

let laminaActual = 'pulpas';
let filtroTipoGlobal = '';
const LAMINAS = {
  pulpas: { etiqueta: 'Pulpas y frutas', tipos: ['PULPA', 'FRUTA'] },
  syrops: { etiqueta: 'Syrops', tipos: ['BOLSA'] },
  hielo: { etiqueta: 'Hielo', tipos: ['CUBO', 'FRAPPE'] }
};

async function vistaGlobal() {
  const { data: stock } = await supabase.from('stock_global').select('*').order('sabor');
  const items = stock || [];

  const semana = semanaActual();
  const { data: certificacion } = await supabase
    .from('certificaciones_semanales').select('*').eq('semana_inicio', semana).maybeSingle();

  const tiposDisponibles = [...new Set(items.map((i) => i.tipo))].sort();
  const puedeCertificar = usuarioActual.rol === 'admin' || usuarioActual.rol === 'bodega' || usuarioActual.rol === 'produccion';

  app.innerHTML = shell('Stock global', `
    <div class="flex justify-between gap-2 px-4 pt-3">
      <div class="flex gap-2 overflow-x-auto">
        ${Object.entries(LAMINAS).map(([clave, l]) => `<button data-lamina="${clave}" class="whitespace-nowrap rounded-full px-3 py-1.5 text-xs ${laminaActual === clave ? 'bg-marca text-white' : 'border border-neutral-200 text-neutral-500'}">${l.etiqueta}</button>`).join('')}
      </div>
      <button id="btn-descargar-pdf" class="whitespace-nowrap rounded-full border border-neutral-200 px-3 py-1.5 text-xs text-neutral-600">⬇ PDF</button>
    </div>

    <div class="flex gap-2 overflow-x-auto px-4 pt-2">
      <select id="select-filtro-tipo-global" class="w-40">
        <option value="">Todos los tipos</option>
        ${tiposDisponibles.map((t) => `<option value="${t}" ${filtroTipoGlobal === t ? 'selected' : ''}>${t}</option>`).join('')}
      </select>
    </div>

    <div class="flex gap-3 px-4 py-2">
      <span class="flex items-center gap-1 text-[10.5px] text-neutral-500"><span class="h-2 w-2 rounded-full bg-verde"></span>9+</span>
      <span class="flex items-center gap-1 text-[10.5px] text-neutral-500"><span class="h-2 w-2 rounded-full bg-amarillo"></span>6-8</span>
      <span class="flex items-center gap-1 text-[10.5px] text-neutral-500"><span class="h-2 w-2 rounded-full bg-rojo"></span>0-5</span>
      <span class="flex items-center gap-1 text-[10.5px] text-neutral-500"><span class="h-2 w-2 rounded-full bg-rojoFluor"></span>neg.</span>
    </div>

    <div id="lista-global" class="max-h-[50vh] overflow-y-auto px-2"></div>

    <div class="border-t border-neutral-200 p-4 mt-3">
      ${certificacion
        ? `<p class="text-xs text-verde">✅ Certificado por ${certificacion.certificado_por} el ${new Date(certificacion.certificado_en).toLocaleDateString('es-CL', { day: '2-digit', month: 'long', year: 'numeric' })}.</p>`
        : puedeCertificar
          ? `<button id="btn-certificar" class="h-9 w-full rounded-lg bg-marca text-xs font-medium text-white">Certificar existencias de esta semana</button>`
          : `<p class="text-xs text-neutral-400">Esta semana aún no ha sido certificada.</p>`
      }
    </div>
  `);
  montarShell();

  document.querySelectorAll('[data-lamina]').forEach((btn) => {
    btn.addEventListener('click', () => { laminaActual = btn.dataset.lamina; vistaGlobal(); });
  });
  document.getElementById('select-filtro-tipo-global').addEventListener('change', (e) => { filtroTipoGlobal = e.target.value; vistaGlobal(); });
  document.getElementById('btn-descargar-pdf').addEventListener('click', () => descargarPdfExistencias(items));
  document.getElementById('btn-certificar')?.addEventListener('click', async () => {
    const { error } = await supabase.from('certificaciones_semanales').insert([{ semana_inicio: semana, certificado_por: usuarioActual.nombre }]);
    if (!error) await vistaGlobal();
  });

  const tiposActivos = LAMINAS[laminaActual].tipos;
  const filtrados = items.filter((i) => tiposActivos.includes(i.tipo) && (!filtroTipoGlobal || i.tipo === filtroTipoGlobal));
  const cont = document.getElementById('lista-global');
  cont.innerHTML = filtrados.length ? filtrados.map((item) => {
    const est = estadoStock(item.total);
    const colorBarra = item.total < 0 ? '#FF1744' : item.total <= 5 ? '#E24B4A' : item.total <= 8 ? '#EF9F27' : '#1D9E75';
    return `
      <div class="flex items-center gap-3 border-b border-neutral-100 px-2 py-2">
        <span class="h-full w-1 self-stretch rounded" style="background-color:${colorBarra}"></span>
        <span class="flex-1"><span class="block text-sm font-medium">${item.sabor}</span><span class="block text-[10.5px] text-neutral-400">${item.tipo}</span></span>
        <span class="rounded-full px-2.5 py-0.5 text-xs font-medium ${est.clase}">${item.total}</span>
      </div>`;
  }).join('') : `<p class="px-4 py-6 text-center text-sm text-neutral-400">Sin productos en esta lámina.</p>`;
}

function descargarPdfExistencias(items) {
  const fecha = new Date().toLocaleDateString('es-CL', { day: '2-digit', month: 'long', year: 'numeric' });
  const filasHtml = items.map((i) => `<tr><td>${i.sabor}</td><td>${i.tipo}</td><td style="text-align:right">${i.total}</td></tr>`).join('');
  const ventana = window.open('', '_blank');
  ventana.document.write(`
    <html><head><title>Existencias — ${fecha}</title>
    <style>
      body{font-family:Arial,sans-serif;padding:24px;color:#222}
      h1{color:#8B3A5C;font-size:18px;margin-bottom:2px}
      p{color:#888;font-size:12px;margin-top:0}
      table{width:100%;border-collapse:collapse;margin-top:16px}
      th,td{padding:6px 8px;border-bottom:1px solid #eee;font-size:12px;text-align:left}
      th{color:#888;font-weight:500}
    </style></head>
    <body>
      <h1>Control de Existencias y Producciones</h1>
      <p>Existencias globales — generado el ${fecha} por ${usuarioActual.nombre}</p>
      <table><thead><tr><th>Sabor</th><th>Tipo</th><th style="text-align:right">Cantidad</th></tr></thead>
      <tbody>${filasHtml}</tbody></table>
    </body></html>
  `);
  ventana.document.close();
  ventana.focus();
  setTimeout(() => ventana.print(), 300);
}

